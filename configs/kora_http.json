{
    "server_host": "0.0.0.0",
    "server_port": 12345,
    "asset_manager": {
        "error_page": "error/404.html",
        "cache": true,
        "enable": true,
        "asset_path": "assets/"
    },
    "netty": {
        "io": "nio",
        "snd_buffer": 65536,
        "reuse_address": true,
        "backlog": 8192,
        "allocator": "default",
        "keep_alive": true,
        "rcv_buffer": 65536,
        "tcp_no_delay": true
    }
}